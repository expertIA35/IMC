# ==============================================================================
# CONFIGURATION ENVIRONNEMENT - INSTITUT ICRCMP
# ==============================================================================

# URL canonique du site en production ou staging
NEXT_PUBLIC_SITE_URL=https://icrcmp.fr

# Clé API Resend pour l'expédition transactionnelle des emails de confirmation
RESEND_API_KEY=re_123456789_abcdefghijklmnopqrstuv

# Adresses d'expédition et de contact institutionnel
EMAIL_FROM="Institut ICRCMP <noreply@icrcmp.fr>"
EMAIL_CONTACT="contact@icrcmp.fr"
DPO_EMAIL="dpo@icrcmp.fr"

# Upstash Redis - Sécurité et Rate Limiting distribué
UPSTASH_REDIS_REST_URL=https://votre-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=AXxxxxxx_votre_token_secret_ici

# Limite de requêtes par minute (IP)
RATE_LIMIT_MAX_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

